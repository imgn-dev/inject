<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>be.imgn.parent</groupId>
        <artifactId>parent</artifactId>
        <version>2026-10-07</version>
        <relativePath/>
    </parent>

    <groupId>be.imgn.inject</groupId>
    <artifactId>inject-parent</artifactId>
    <version>0.1.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>imgn inject parent</name>
    <description>Build configuration shared by the imgn inject modules.</description>
    <url>https://github.com/imgn-dev/inject</url>

    <scm>
        <connection>scm:git:https://github.com/imgn-dev/inject.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/imgn-dev/inject.git</developerConnection>
        <url>https://github.com/imgn-dev/inject</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>inject</module>
        <module>inject-processor</module>
        <module>inject-log</module>
        <module>inject-log-processor</module>
        <module>inject-examples</module>
        <module>inject-maven-plugin</module>
        <module>inject-examples-module</module>
    </modules>

    <properties>
        <java.release>21</java.release>

        <!-- NullAway ExcludedFieldAnnotations: fields carrying these are initialized by the framework, not the
             constructor. @Inject is core; each consumed injecting-annotation plugin (e.g. @Log) must add its
             annotation here. ExcludedPaths replaces the parent's: module descriptors name services and providers
             by their fully qualified names, which UnnecessarilyFullyQualified would otherwise reject. -->
        <errorprone.extra.args>-XepExcludedPaths:.*/target/generated-sources/.*|.*/module-info\.java -XepOpt:NullAway:ExcludedFieldAnnotations=be.imgn.inject.Inject,be.imgn.inject.log.Log -Xep:InvalidInlineTag:OFF -Xep:InvalidLink:OFF -Xep:AnnotateFormatMethod:OFF -Xep:ImmutableEnumChecker:OFF</errorprone.extra.args>

        <jacoco-plugin.version>0.8.15</jacoco-plugin.version>
        <maven-api.version>3.9.16</maven-api.version>
        <maven-plugin-tools.version>3.15.2</maven-plugin-tools.version>
        <asm.version>9.10.1</asm.version>
        <groovy.version>5.0.6</groovy.version>
        <gaia.version>0.1.0</gaia.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>be.imgn.parent</groupId>
                <artifactId>bom</artifactId>
                <version>2026-10-07</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>be.imgn.gaia</groupId>
                <artifactId>gaia-bom</artifactId>
                <version>${gaia.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-checkstyle-plugin</artifactId>
                    <configuration>
                        <!-- Replaces the parent's suppressions file; see the file for what it restates. -->
                        <suppressionsLocation>${maven.multiModuleProjectDirectory}/checkstyle-suppressions.xml</suppressionsLocation>
                    </configuration>
                </plugin>
                <!-- The release profile hands every reactor module to Central. The examples are read as source, not
                     consumed as artifacts, and the @Log modules exercise the processor plugin SPI. -->
                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <configuration>
                        <excludeArtifacts>
                            <excludeArtifact>inject-examples</excludeArtifact>
                            <excludeArtifact>inject-examples-module</excludeArtifact>
                            <excludeArtifact>inject-log</excludeArtifact>
                            <excludeArtifact>inject-log-processor</excludeArtifact>
                        </excludeArtifacts>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <!-- Not recognized on JDK 21; requires host JDK 24+ to run tests. Compiled bytecode still targets Java 21 (java.release). -->
                        <argLine>@{argLine} --sun-misc-unsafe-memory-access=allow</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>prepare-agent</id>
                            <goals><goal>prepare-agent</goal></goals>
                        </execution>
                        <execution>
                            <id>report</id>
                            <phase>test</phase>
                            <goals><goal>report</goal></goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <configuration>
                        <links>
                            <link>https://docs.oracle.com/en/java/javase/21/docs/api/</link>
                        </links>
                        <!-- all: syntax, references, HTML, and completeness. Missing documentation is a warning, so
                             failOnWarnings is what turns it into a build failure. -->
                        <doclint>all</doclint>
                        <!-- Sibling modules publish no apidocs under the project URL, so there is nothing to link. -->
                        <detectOfflineLinks>false</detectOfflineLinks>
                        <quiet>true</quiet>
                    </configuration>
                    <executions>
                        <execution>
                            <id>check-javadoc</id>
                            <phase>package</phase>
                            <goals>
                                <goal>javadoc-no-fork</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
